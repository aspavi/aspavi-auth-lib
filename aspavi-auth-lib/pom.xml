<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.aspavi</groupId>
        <artifactId>aspavi-auth-parent</artifactId>
        <version>1.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>aspavi-auth-lib</artifactId>
    <packaging>jar</packaging>

    <name>Aspavi Auth Library</name>
    <description>
        Spring Boot auto-configuration for multi-tenant JWT authentication with Keycloak
        and PostgreSQL Row-Level Security via a tenant-aware transaction manager.
    </description>

    <dependencies>
        <!-- Spring Boot auto-configuration support (compile-time, no starter) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- Web + Security (provided by consuming service) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- OAuth2 Resource Server / JWT -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- JPA / Hibernate — TenantAwareJpaTransactionManager extends JpaTransactionManager -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Servlet API (provided by the application container) -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Configuration-properties annotation processor -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- TenantAwareJpaTransactionManagerTest: row-level security on a real PostgreSQL (needs Docker) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              NoJpaClasspathTest needs a classpath without JPA, like a service without a database.
              It runs in its own execution with those artifacts removed; the default one skips it.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludes>
                                <exclude>**/NoJpaClasspathTest.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>no-jpa-classpath</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/NoJpaClasspathTest.java</include>
                            </includes>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>jakarta.persistence:jakarta.persistence-api</classpathDependencyExclude>
                                <classpathDependencyExclude>org.springframework:spring-orm</classpathDependencyExclude>
                                <classpathDependencyExclude>org.hibernate.orm:hibernate-core</classpathDependencyExclude>
                                <classpathDependencyExclude>org.springframework.data:spring-data-jpa</classpathDependencyExclude>
                                <classpathDependencyExclude>org.springframework.boot:spring-boot-data-jpa</classpathDependencyExclude>
                                <classpathDependencyExclude>org.springframework.boot:spring-boot-jpa</classpathDependencyExclude>
                                <classpathDependencyExclude>org.springframework.boot:spring-boot-hibernate</classpathDependencyExclude>
                                <classpathDependencyExclude>com.h2database:h2</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
